 /// Maximum age for pooled QUIC/HTTP/3 connections.
 const MAX_H3_AGE: Duration = Duration::from_secs(120);
 
+/// Tracks the number of active long-lived multiplexed streams (WebSocket /
+/// Extended CONNECT tunnels) currently riding a pooled H2/H3 connection.
+///
+/// The age caps above exist to recycle pooled connections before a backend's
+/// idle GOAWAY would (avoiding reuse-race 502s). That is correct for stateless
+/// request multiplexing, but a long-lived WebSocket tunnel must NOT be severed
+/// mid-stream just because the underlying pooled connection crossed the age cap.
+/// While `count() > 0`, the connection is exempt from age-based proactive
+/// eviction; it is removed only once its active tunnels drain.
+#[derive(Clone, Default)]
+pub struct ActiveStreams(Arc<AtomicU64>);
+
+impl ActiveStreams {
+    /// Current number of active multiplexed tunnels on this connection.
+    pub fn count(&self) -> u64 {
+        self.0.load(Ordering::Relaxed)
+    }
+
+    /// Register a new active tunnel. The returned guard decrements the count
+    /// when dropped (i.e. when the WebSocket tunnel task ends), so the pool can
+    /// resume normal age-based eviction once the connection is idle again.
+    pub fn guard(&self) -> ActiveStreamGuard {
+        self.0.fetch_add(1, Ordering::Relaxed);
+        ActiveStreamGuard(Arc::clone(&self.0))
+    }
+}
+
+/// RAII guard kept alive for the lifetime of a WebSocket/Extended CONNECT
+/// tunnel; decrements the owning connection's active-stream count on drop.
+pub struct ActiveStreamGuard(Arc<AtomicU64>);
+
+impl Drop for ActiveStreamGuard {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::Relaxed);
+    }
+}
